# Create POS secrets with:
# POS_POSTGRES_PASSWORD=$(openssl rand -hex 32)
# SESSION_SECRET=$(openssl rand -hex 32)
POS_POSTGRES_DB=payassure_pos
POS_POSTGRES_USER=payassure_pos
POS_POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-password
SESSION_SECRET=replace-with-a-random-64-character-hex-secret

# For local Node development only; Compose constructs its own dedicated URL.
DATABASE_URL=

# Optional PayAssure integration. Configure all three credentials to enable it.
PAYASSURE_API_BASE_URL=
PAYASSURE_IDENTIFIER=
PAYASSURE_PASSWORD=

# Public, externally reachable callback URL ending in /webhook.
PAYASSURE_WEBHOOK_URL=

# Keep both disabled except during troubleshooting.
PAYASSURE_DEBUG=false
SESSION_DIAGNOSTICS=false

# Optional migration source. Set only after verifying it is the existing POS
# database, never the Settlement Engine database.
SOURCE_DATABASE_URL=
